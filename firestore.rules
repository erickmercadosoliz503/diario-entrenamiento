rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function profile(uid) { return get(/databases/$(database)/documents/profiles/$(uid)).data; }
    function isCoachOf(uid) {
      return signedIn() && exists(/databases/$(database)/documents/profiles/$(uid))
        && profile(uid).coach_id == request.auth.uid;
    }

    // Perfiles: cada usuario el suyo; el entrenador ve los de sus clientes
    match /profiles/{uid} {
      allow read: if isMe(uid) || (signedIn() && resource.data.coach_id == request.auth.uid);
      allow create: if isMe(uid) && request.resource.data.id == uid
        && (
          (request.resource.data.role == 'coach' && request.resource.data.coach_id == null
            && get(/databases/$(database)/documents/coachCodes/$(request.resource.data.coach_code)).data.coachId == request.auth.uid)
          || (request.resource.data.role == 'cliente' && (
                request.resource.data.coach_id == null
                || profile(request.resource.data.coach_id).role == 'coach'))
        );
      allow update: if isMe(uid)
        && request.resource.data.id == resource.data.id
        && request.resource.data.role == resource.data.role
        && request.resource.data.coach_id == resource.data.coach_id
        && request.resource.data.get('coach_code', null) == resource.data.get('coach_code', null);
      allow delete: if isMe(uid);
    }

    // Códigos de entrenador: se consultan uno a uno (no se pueden listar)
    match /coachCodes/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && request.resource.data.coachId == request.auth.uid
        && request.resource.data.keys().hasOnly(['coachId']);
      allow delete: if signedIn() && resource.data.coachId == request.auth.uid;
    }

    // Plan: lo escribe el entrenador; lo lee el cliente y su entrenador
    match /plans/{clientId} {
      allow read: if isMe(clientId) || isCoachOf(clientId);
      allow write: if isCoachOf(clientId);
      allow delete: if isMe(clientId) || isCoachOf(clientId);
    }

    // Sesiones y revisiones: las escribe su dueño; el entrenador las lee
    match /{col}/{docId} {
      allow read: if col in ['sessions', 'checkins']
        && (isMe(resource.data.user_id) || isCoachOf(resource.data.user_id));
      allow create, update: if col in ['sessions', 'checkins']
        && isMe(request.resource.data.user_id)
        && (resource == null || resource.data.user_id == request.auth.uid);
      allow delete: if col in ['sessions', 'checkins'] && isMe(resource.data.user_id);
    }
  }
}
